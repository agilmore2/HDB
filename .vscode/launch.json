{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "-a ~/.app_user_login_service -n 2 -d -t -l u -A MRGCD",
            "envFile": "/home/agilmore/workspace/HDB/bashrc_hdb_app_local",
            "justMyCode": false,
            "env": {"PYTHONPATH": "..:python"},
            //"args": "${command:pickArgs}"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "/home/agilmore/workspace/HDB/bashrc_hdb_app_local",
            "justMyCode": false,
            "args": " -l d -a ~/.app_user_login_service -n 5 -t",
        },

        {
            "name": "hdb2report: CODWR Historical Daily Data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/hdb2report/hdb2report.py",
            "python": "${workspaceFolder}/python/venv/bin/python",
            "console": "integratedTerminal",
            "envFile": "/home/agilmore/workspace/HDB/bashrc_hdb_app_local",
            "justMyCode": false,
            "args": ["-a", "~/.app_user_login_service", "-n", "7", "-s", "CODWR Historical Daily Data"]
        },

        {
            "name": "hdb2report: Colorado Division of Water Resources (CODWR)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/hdb2report/hdb2report.py",
            "python": "${workspaceFolder}/python/venv/bin/python",
            "console": "integratedTerminal",
            "envFile": "/home/agilmore/workspace/HDB/bashrc_hdb_app_local",
            "justMyCode": false,
            "args": ["-a", "~/.app_user_login_service", "-f", "csv","-n", "7", "-i", "BTBLESCO,BTABESCO", "-s", "Colorado Division of Water Resources (CODWR)"]
        },

        {
            "type": "perl",
            "request": "launch",
            "name": "Perl-Debug Current File",
            "program": "${file}",
            "stopOnEntry": true,
            "reloadModules": true,
            "env": {
                "HDB_ENV": "${env:HDB_ENV}",
            },
            "args": "-a ~/.app_user_login_service -l u -n 1 -e 30-APR-2019 -dwt"
        },
        
    ]
}